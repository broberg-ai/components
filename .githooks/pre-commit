#!/usr/bin/env bash
# Refuse to commit a secret, or a mutation. Four layers, cheapest first.
#
# Layer 0 is not about secrets at all (F081.1) — it refuses while a mutation
# harness has broken code on disk. It sits here because this is the one place
# every commit already passes through.
#
# Written 2026-08-23 after a GatewayAPI token arrived and this repo turned out to
# have NO git hooks at all — nothing stood between a credential and `git push`.
#
# The interesting layer is 2. A GatewayAPI token is 64 characters of letters,
# digits and hyphens with no prefix: there is no format to match that would not
# also match every hash, id and base64 blob in the repo. So the reliable guard is
# not "does this look like a secret" but "is this one of MY secrets" — matched
# against the actual values in .env. That works for any credential, whatever
# shape it has, with no false positives.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
fail() { echo "" >&2; echo "COMMIT BLOCKED — $1" >&2; echo "" >&2; exit 1; }

# Only ADDED lines are scanned (F061.4). A secret on a REMOVED line is already in
# git history, so refusing that commit blocks the only cleanup that helps and
# leaves --no-verify as the sole way out — which must never happen to this gate.
# Measured: deleting a doc that quoted AWS's public example key was refused by the
# very layer that exists to get such a value out of the tree.
#
# `grep` exits 1 when it matches nothing, which under `set -euo pipefail` would
# kill the hook. A diff with zero added lines is not an error — it is exactly the
# pure-deletion commit this exists for — so both greps tolerate an empty result.
added_lines() {
  git diff --cached -U0 -- "$@" \
    | { grep '^+' || true; } \
    | { grep -v '^+++' || true; } \
    | sed 's/^+//'
}

# ── 0. Not while a mutation harness is running ─────────────────────────────
# A harness puts DELIBERATELY BROKEN code on disk for seconds at a time — a
# guard rewritten to `if (false)`, a fallback deleted — and then restores it. A
# commit that lands inside that window captures the mutant.
#
# CI would catch it (the mutated code fails its own tests), so this is not the
# last line of defence. It is here because the alternative is a rule an agent has
# to remember, and the harness contract in CLAUDE.md is explicit that a gate must
# not depend on remembering anything. Cheapest layer, so it runs first.
#
# The marker also STAYS BEHIND when a restore fails, which is the case that
# matters: the tree is then genuinely broken and this block is the only thing
# standing in front of it. Its contents say which of the two it is.
# -e, NOT -f. It is a DIRECTORY with one entry per PID: `turbo run test` runs
# packages in parallel, so several harnesses hold it at once, and with a single
# shared file the first to finish removed it for everyone else still mutating.
# A reader testing for a regular file gets a false all-clear.
if [ -e "$ROOT/.mutation-running" ]; then
  # EACH ENTRY IS NAMED BY ITS PID, so "is this stale?" is answerable rather
  # than a judgement call — ask the process table about that exact pid.
  #
  # This block used to say "if nothing is running (ps aux | grep mutations.mjs)".
  # super measured that advice and it is WRONG: the pattern is a SUBSTRING and
  # matches scripts/test-precommit-secret-gate-mutations.mjs, which is not one of
  # the four marker-bearing harnesses. The count was a true number answering a
  # different question, and a reader following it would wait for a process that
  # was never holding the marker. `ps -p <pid>` asks about THIS harness.
  # THREE STATES, NOT TWO — super's second finding, and it is the same family as
  # their first. `ps -p <pid>` answers "does this pid exist", NOT "is MY process
  # still there". A harness that died without clearing its entry leaves a pid the
  # OS is free to hand to something else, and macOS does reuse pids overnight.
  # The hook would then report a stranger as "still running", the STALE branch
  # would never be reached, and it would block forever waiting on a process that
  # was never ours.
  #
  # The entry already carries `since`, so the stranger gives itself away: it
  # STARTED AFTER the marker was written. Ours started before.
  marker_epoch() {  # ISO-8601 from the entry -> epoch seconds
    LC_ALL=C date -j -u -f "%Y-%m-%dT%H:%M:%S" "${1%%.*}" +%s 2>/dev/null
  }
  proc_epoch() {    # a pid's start time -> epoch seconds
    # LC_ALL=C on BOTH, and it is not decoration: on a Danish-locale Mac `ps -o
    # lstart=` prints "tir.  1 sep. 01:31:34 2026", which `date -f "%a %b %d…"`
    # cannot parse. Measured — without it every live pid fell into the "could not
    # check" branch, which is the SAFE direction and would still have been wrong
    # every single time.
    started="$(LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//;s/ *$//')"
    [ -n "$started" ] || return 1
    LC_ALL=C date -j -f "%a %b %d %T %Y" "$started" +%s 2>/dev/null
  }

  alive=0
  detail=""
  for entry in "$ROOT/.mutation-running"/*; do
    [ -e "$entry" ] || continue
    pid="$(basename "$entry")"
    since="$(sed -n 's/^ *since *//p' "$entry" | head -1)"

    if ! ps -p "$pid" >/dev/null 2>&1; then
      detail="$detail
  ── pid $pid is GONE: this entry is STALE, the restore never cleaned up ──"
    else
      # `|| true` is load-bearing under `set -e`: an unparseable date makes the
      # substitution non-zero and would kill the hook SILENTLY — no message, no
      # block, the commit sails through. Measured: the whole layer produced empty
      # output and three tests failed with `in: <nothing>`.
      m="$(marker_epoch "$since" || true)"
      p="$(proc_epoch "$pid" || true)"
      if [ -z "$m" ] || [ -z "$p" ]; then
        # Could not compare. That is a THIRD outcome and it is not "fine" — it
        # keeps the block up and says so, rather than quietly picking the
        # reassuring branch.
        alive=$((alive + 1))
        detail="$detail
  ── pid $pid EXISTS, but I could NOT check it is the same process (start time
     unreadable). Treating it as running, because guessing the other way would
     tell you to clear a marker over a live mutation ──"
      elif [ "$p" -gt "$((m + 2))" ]; then
        detail="$detail
  ── pid $pid was REUSED: a different process now holds it (started after this
     entry was written). The harness is gone — this entry is STALE ──"
      else
        alive=$((alive + 1))
        detail="$detail
  ── pid $pid is STILL RUNNING ──"
      fi
    fi

    detail="$detail
$(sed 's/^/    /' "$entry")"
  done

  if [ "$alive" -gt 0 ]; then
    fail "a mutation harness is still running in this repo ($alive of them).
$detail

  Wait for it to finish — the marker clears itself."
  fi

  fail "a mutation harness left this behind and is NOT running any more.
$detail

  Every entry is stale, so either a harness was killed mid-run or a restore
  failed. CHECK THE FILES NAMED ABOVE before you clear it — they may still hold
  the mutation:

    git status
    rm -r $ROOT/.mutation-running"
fi

# ── 1. The env file itself must never be staged ────────────────────────────
staged_env="$(git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)"
if [ -n "$staged_env" ]; then
  fail "these are env files and must not be committed:
$(echo "$staged_env" | sed 's/^/    /')

  git restore --staged $(echo "$staged_env" | tr '\n' ' ')"
fi

# ── 2. No VALUE from .env may appear anywhere in the staged diff ───────────
# The layer that catches a credential with no recognisable format.
if [ -f "$ROOT/.env" ]; then
  diff_file="$(mktemp)"; trap 'rm -f "$diff_file"' EXIT
  added_lines . > "$diff_file"
  while IFS= read -r line; do
    name="${line%%=*}"
    value="${line#*=}"
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    # Short values are words, not credentials, and would fire on ordinary text.
    [ "${#value}" -lt 12 ] && continue
    if grep -qF -- "$value" "$diff_file"; then
      fail "the value of \$$name from .env appears in this commit.
  That credential is now in the staged diff. Remove it and read it from the
  environment instead — and if it has already been pushed anywhere, ROTATE it."
    fi
  done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ROOT/.env" || true)
fi

# ── 3. Known credential FORMATS, for secrets that are not ours ─────────────
# Catches a key pasted from somewhere else — a provider token in a code sample,
# a colleague's key in a fixture. @broberg/secret-scan owns the pattern list.
SCAN="$ROOT/packages/secret-scan/dist/index.js"
# A MISSING scanner is not a clean commit. dist/ is gitignored, so a fresh clone
# has no scanner until somebody builds — and this layer used to skip silently in
# exactly that case, exiting 0 on a real credential (F061.5, measured). An
# unanswerable question must read as UNANSWERED, never as COMPLIANT.
if [ ! -f "$SCAN" ]; then
  fail "the credential-format layer cannot run — @broberg/secret-scan is not built.
  This layer is what catches a provider token pasted in from elsewhere, so the
  commit is refused rather than passed unchecked. Build it once:

    pnpm --filter @broberg/secret-scan build"
fi

# Layer 3 ONLY may be narrowed, via .secretscanignore. A scanner's own test
# fixtures have to look like credentials, so without an exemption the package
# could never test its own patterns. Layers 1 and 2 above are deliberately not
# exemptable — an opt-out that reaches the layer catching REAL secrets is a
# hole, not a feature.
EXCLUDES=()
if [ -f "$ROOT/.secretscanignore" ]; then
  while IFS= read -r pat; do
    [ -z "$pat" ] && continue
    case "$pat" in \#*) continue ;; esac
    EXCLUDES+=(":(exclude)$pat")
  done < "$ROOT/.secretscanignore"
fi
added_lines . "${EXCLUDES[@]}" | node --input-type=module -e '
  const { redactSecrets } = await import(process.argv[1]);
  let text = ""; for await (const c of process.stdin) text += c;
  const r = redactSecrets(text);
  const real = (r.findings ?? []).filter(f => f.label !== "announced-secret");
  if (real.length) {
    console.error("  " + real.map(f => `${f.label} ×${f.count ?? 1}`).join("\n  "));
    process.exit(1);
  }
' "$SCAN" || fail "@broberg/secret-scan recognised a credential format in this commit (listed above)."

exit 0
