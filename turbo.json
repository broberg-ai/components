{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [
        ".vitest-report/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
