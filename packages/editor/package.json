{
  "name": "@broberg/editor",
  "version": "0.1.0",
  "description": "The fleet's shared WYSIWYG editor on TipTap: a headless core (createEditor, toolbarState, markdown in/out), server-side HTML rendering without a browser, image upload through your own callback, and thin React/Preact adapters. Epic F101.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js",
      "require": "./dist/preact.cjs"
    },
    "./css/editor.css": "./css/editor.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "tiptap",
    "prosemirror",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "happy-dom": "^15.11.7",
    "preact": "^10.29.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "preact": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "preact": {
      "optional": true
    }
  }
}
