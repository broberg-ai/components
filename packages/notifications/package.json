{
  "name": "@broberg/notifications",
  "version": "0.3.0",
  "description": "Headless in-app notification core for the broberg.ai fleet \u2014 one counting rule shared by every app, so the list and the OS badge can never disagree. The package never owns your count query, your database, or your list UI: you supply a store, it owns the choreography.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js",
      "require": "./dist/shell.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.react.json"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/react": "^16.0.0",
    "happy-dom": "^15.0.0",
    "@broberg/ui-controls-core": "0.1.1"
  },
  "keywords": [
    "a11y",
    "app badge",
    "badge",
    "bell",
    "broberg",
    "focus trap",
    "headless",
    "inbox",
    "notification",
    "notification bell",
    "notifications",
    "popover",
    "pwa",
    "unread",
    "unseen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/notifications"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@broberg/ui-controls-core": ">=0.1.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@broberg/ui-controls-core": {
      "optional": true
    }
  }
}
