{
  "name": "@broberg/auth",
  "version": "0.4.0",
  "description": "Thin fleet wrapper around Better Auth \u2014 one createAuth() for email+password, magic-link (via @broberg/mail), social login (Google/Apple/GitHub/Microsoft/LinkedIn/Facebook) and passkey/WebAuthn, with dark-ship provider guards and Hono + Next mount helpers. Runs in your own app/DB \u2014 no external service.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./passkey": {
      "types": "./dist/passkey.d.ts",
      "import": "./dist/passkey.js",
      "require": "./dist/passkey.cjs"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js",
      "require": "./dist/drizzle.cjs"
    },
    "./package.json": "./package.json",
    "./two-factor": {
      "types": "./dist/two-factor.d.ts",
      "import": "./dist/two-factor.js",
      "require": "./dist/two-factor.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:clean-install": "node verify-clean-install.mjs"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0",
    "drizzle-orm": ">=0.30.0",
    "@broberg/mail": ">=0.3.0",
    "@better-auth/passkey": ">=1.6.0",
    "hono": ">=4.0.0",
    "next": ">=14.0.0",
    "uqr": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@broberg/mail": {
      "optional": true
    },
    "@better-auth/passkey": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "uqr": {
      "optional": true
    }
  },
  "peerDependenciesComment": "better-auth is a peer so the consumer pins ONE version shared between this server wrapper and better-auth/client on the frontend. @broberg/mail is an optional peer \u2014 only needed when you enable magic-link (you pass the Mailer in; we import its type only).",
  "devDependencies": {
    "@better-auth/passkey": "^1.6.0",
    "@types/node": "^22.0.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "uqr": "^0.1.3",
    "jsqr": "^1.4.0"
  },
  "keywords": [
    "auth",
    "better-auth",
    "oauth",
    "passkey",
    "webauthn",
    "magic-link",
    "sso",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "entryPeers": {
    ".": [],
    "./hono": [
      "hono"
    ],
    "./next": [
      "next"
    ],
    "./passkey": [
      "@better-auth/passkey"
    ],
    "./drizzle": [
      "drizzle-orm"
    ],
    "./two-factor": [
      "uqr"
    ],
    "./package.json": []
  }
}
