{
  "name": "@broberg/phone",
  "version": "0.1.0",
  "description": "Ring a person over the phone network for the broberg.ai fleet — 46elks (EU): play a message (audio from @broberg/ai-sdk ai.tts), ask for one key press to acknowledge, and parse the hangup + key-press webhooks with a secret token (46elks does not sign them). Never throws; failures carry a kind; ready/no-keys/invalid-keys at boot; numbers masked. Zero dependencies, no database.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "phone",
    "call",
    "46elks",
    "ivr",
    "dtmf",
    "acknowledge",
    "alarm",
    "voice call",
    "telefoni",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/phone"
  },
  "publishConfig": {
    "access": "public"
  }
}
