{
  "name": "@broberg/nativepush",
  "version": "0.1.0",
  "description": "Push to NATIVE apps for the broberg.ai fleet — Apple APNs (token auth, HTTP/2, critical / time-sensitive) and Google FCM HTTP v1 (high-priority, data-only) behind one sender with @broberg/webpush's contract: never throws, dead tokens to prune, failed with a kind, ready/no-keys/invalid-keys at boot. Server-side, zero dependencies, no database.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "push",
    "apns",
    "fcm",
    "firebase",
    "ios",
    "android",
    "critical-alerts",
    "capacitor",
    "notifications",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/nativepush"
  },
  "publishConfig": {
    "access": "public"
  }
}
