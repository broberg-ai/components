{
  "name": "@broberg/web-clipper",
  "version": "0.1.0",
  "description": "The fleet's one web-clipper base (Trail Web Clipper, Jam Clipper). First piece: @broberg/web-clipper/core \u2014 the fingerprint engine: a fingerprint per unit (role + content + position), a chain fingerprint that includes the previous one, send-only-new, idempotent resend keys, and branches when an earlier unit changes (nothing is overwritten). No browser dependency.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "css",
    "README.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js",
      "require": "./dist/extract.cjs"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "require": "./dist/transport.cjs"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "require": "./dist/content.cjs"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "require": "./dist/extension.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./css/clipper.css": "./css/clipper.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/turndown": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^25.0.1",
    "@broberg/theme": "workspace:*",
    "@testing-library/preact": "^3.2.3",
    "happy-dom": "^15.0.0",
    "preact": "^10.23.0",
    "vite": "^7.1.0",
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@preact/preset-vite": "^2.10.2"
  },
  "keywords": [
    "web-clipper",
    "clipper",
    "browser-extension",
    "fingerprint",
    "dedupe",
    "idempotent",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/web-clipper"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.4",
    "@broberg/ui-controls-core": "^0.2.3"
  },
  "peerDependencies": {
    "@broberg/theme": ">=0.13.0",
    "preact": ">=10.0.0",
    "vite": ">=5",
    "@crxjs/vite-plugin": ">=2.0.0-beta.28",
    "@preact/preset-vite": ">=2.8.0"
  },
  "peerDependenciesMeta": {
    "@broberg/theme": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@crxjs/vite-plugin": {
      "optional": true
    },
    "@preact/preset-vite": {
      "optional": true
    }
  }
}
