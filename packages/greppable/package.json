{
  "name": "@broberg/greppable",
  "version": "0.2.0",
  "description": "Find the tracked text files your grep silently skips. A cc session's grep is ugrep with -I: on a file with a NUL byte or invalid UTF-8 it prints nothing and exits 1, so every grep-based sweep over that file is falsely green. Zero deps, one bin, runs in any CI.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "greppable": "bin/greppable.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "grep",
    "ugrep",
    "ripgrep",
    "utf-8",
    "latin-1",
    "encoding",
    "nul-byte",
    "binary-detection",
    "ci",
    "lint",
    "audit",
    "false-green",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/greppable"
  },
  "publishConfig": {
    "access": "public"
  }
}
