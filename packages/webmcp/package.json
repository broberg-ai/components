{
  "name": "@broberg/webmcp",
  "version": "0.1.0",
  "description": "WebMCP for the fleet. First piece: @broberg/webmcp/testing — what a test harness (Lens, CI) needs to drive a page's WebMCP tools: the Chromium launch flag, and a tester that lists and calls the page's registered tools over the DevTools protocol's WebMCP domain, with a read-only-unless-told safety rule. No browser dependency.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "testing",
    "chromium",
    "devtools-protocol",
    "lens",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/webmcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
