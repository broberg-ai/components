{
  "name": "@broberg/data-table",
  "version": "0.1.2",
  "description": "The fleet's data table for Stack B (Preact, no shadcn): sorting, search, pagination, multi-select with an indeterminate select-all, remembered column visibility, a row ⋮-menu and typed cells (badge, status, number, select). Framework-free core + Preact component, styled on @broberg/theme tokens.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js",
      "require": "./dist/preact.cjs"
    },
    "./css/data-table.css": "./css/data-table.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@broberg/ui-controls-core": "^0.2.3"
  },
  "peerDependencies": {
    "@broberg/theme": ">=0.11.0",
    "preact": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@broberg/theme": "workspace:*",
    "@testing-library/preact": "^3.2.3",
    "happy-dom": "^15.0.0",
    "preact": "^10.23.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "data-table",
    "table",
    "datagrid",
    "sorting",
    "pagination",
    "preact",
    "stack-b",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/data-table"
  },
  "publishConfig": {
    "access": "public"
  }
}
