{
  "name": "@broberg/mail-templates",
  "version": "0.1.0",
  "description": "The engine behind a mail template: a block model (paragraph, heading, note, button, divider, html) and brand, the one correct render order with escaped placeholders, a per-tenant override over a coded default, and the content hash a host versions on. Storage-agnostic; wraps in @broberg/mail-core's shell, sends with @broberg/mail.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@broberg/mail-core": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "email",
    "mail-templates",
    "email-templates",
    "multi-tenant",
    "template-override",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/mail-templates"
  },
  "publishConfig": {
    "access": "public"
  }
}
