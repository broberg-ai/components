{
  "name": "@broberg/s3",
  "version": "0.2.2",
  "description": "Upload and download files of any size DIRECTLY between the browser and S3-compatible storage (Cloudflare R2 in the EU by default; Tigris, AWS, MinIO by endpoint) — the site's server only issues short-lived, one-object signatures, so bytes never pass through it. Multipart upload with parallel parts, retry, progress (%, speed, time left) and resume after a dropped connection; presigned download links. One fetch handler (Request → Response) for Hono/Bun and Next, guarded by the site's own authorize() hook and a per-user object prefix. Preact hook, no visual component.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js",
      "require": "./dist/preact.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^15.0.0",
    "preact": "^10.24.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "s3",
    "r2",
    "cloudflare",
    "tigris",
    "upload",
    "download",
    "multipart",
    "presigned",
    "large files",
    "resumable",
    "store filer",
    "upload af video",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/s3"
  },
  "publishConfig": {
    "access": "public"
  }
}
