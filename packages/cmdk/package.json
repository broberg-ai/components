{
  "name": "@broberg/cmdk",
  "version": "0.2.0",
  "description": "Headless Cmd+K command-palette core: a framework-free fuzzyFilter (ranked subsequence match), a createPaletteController state machine (open/query/results/active-index with wrap-around keyboard nav + Enter activation), and a quota-safe localStorage recents store. Items are always consumer-defined; the React/Preact shells build on this. Zero deps.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js",
      "require": "./dist/preact.cjs"
    },
    "./css/cmdk.css": "./css/cmdk.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.3",
    "happy-dom": "^15.0.0",
    "preact": "^10.23.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "command-palette",
    "cmdk",
    "cmd-k",
    "fuzzy-search",
    "keyboard-navigation",
    "quick-actions",
    "headless",
    "broberg",
    "preact"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/cmdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "preact": ">=10.11.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  }
}
