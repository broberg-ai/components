{
  "name": "@broberg/legal",
  "version": "0.4.0",
  "description": "One set of legal documents for every broberg.ai product — terms, privacy, trust, DPA, support agreement — as structured, versioned, content-hashed data in Danish (master) and English. Sites style and re-flow; they never edit. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "legal",
    "gdpr",
    "privacy",
    "terms",
    "dpa",
    "i18n",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/legal"
  },
  "publishConfig": {
    "access": "public"
  }
}
