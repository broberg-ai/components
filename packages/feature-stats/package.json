{
  "name": "@broberg/feature-stats",
  "version": "0.1.0",
  "description": "Which features are actually used: aggregate per-day counters (feature, day, count) with no user id, session, IP, path or cookie. Framework-free core, a SQL store for libSQL/Turso and Postgres, and thin Hono / Next / browser-beacon bindings.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@broberg/db-sdk": "0.2.0",
    "@libsql/client": "^0.18.0",
    "hono": "^4.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "keywords": [
    "feature usage",
    "feature stats",
    "analytics",
    "usage",
    "counters",
    "privacy",
    "gdpr",
    "no cookie",
    "hono",
    "nextjs",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/feature-stats"
  },
  "publishConfig": {
    "access": "public"
  }
}
