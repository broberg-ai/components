{
  "name": "@broberg/voice",
  "version": "0.1.1",
  "description": "Voice calls for 2–10 people on a self-hosted LiveKit SFU: the app's server mints a short-lived, room-bound, microphone-only ticket and verifies LiveKit's signed webhooks; the browser joins with noise suppression, echo cancellation and auto gain, and gets mute, output mute, device choice, per-person volume, who-is-speaking and the participant list.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "voice",
    "webrtc",
    "livekit",
    "sfu",
    "audio-call",
    "huddle",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/voice"
  },
  "publishConfig": {
    "access": "public"
  }
}
