{
  "name": "@broberg/realtime",
  "version": "0.2.0",
  "description": "Live channels for chat and realtime: an SSE stream per channel with Last-Event-ID resume, durable vs ephemeral events, presence with expiry, fan-out across machines via Postgres LISTEN/NOTIFY, and a browser client that reopens on foreground/online/silence plus an optimistic outbox. Web-standard Response; the client imports nothing from node.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "realtime",
    "sse",
    "server-sent-events",
    "chat",
    "presence",
    "typing-indicator",
    "last-event-id",
    "postgres-listen-notify",
    "optimistic-ui",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/realtime"
  },
  "publishConfig": {
    "access": "public"
  }
}
