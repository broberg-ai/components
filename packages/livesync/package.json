{
  "name": "@broberg/livesync",
  "version": "0.1.0",
  "description": "Real-time collaborative editing on Yjs for the fleet: a sync server that runs inside your own app (login check before the first byte, read/write per document, load/store hooks in your own database), and a browser client that reconnects, keeps working offline (IndexedDB) and merges on reconnect, with presence (who is here, cursors). Epic F100.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node verify-exports.mjs",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "livesync",
    "yjs",
    "crdt",
    "collaborative-editing",
    "realtime",
    "offline",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/livesync"
  },
  "publishConfig": {
    "access": "public"
  }
}
