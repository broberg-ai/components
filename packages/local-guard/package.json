{
  "name": "@broberg/local-guard",
  "version": "0.1.0",
  "description": "One guard for a local HTTP daemon on 127.0.0.1: Host must name this loopback address on its own port (421 — closes DNS rebinding), and a write must be application/json (415 — a cross-site page cannot send that without a CORS preflight). Framework-free core on Web Request + a Hono middleware. Extracted from @broberg/lens-daemon so lens and auth-relay stop carrying copies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "hono": "^4.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": ["localhost", "loopback", "dns-rebinding", "csrf", "host-header", "daemon", "local-server", "security", "hono", "bun", "broberg"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/local-guard"
  },
  "publishConfig": {
    "access": "public"
  }
}
