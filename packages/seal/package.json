{
  "name": "@broberg/seal",
  "version": "0.2.0",
  "description": "Encrypt secrets you must store and read back — a customer's own API key, an OAuth refresh token — with AES-256-GCM envelope encryption, a required context (AAD) and key rotation. Web Crypto only, zero dependencies; Node, Bun, Deno and edge.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "encryption",
    "encryption-at-rest",
    "aes-gcm",
    "aes-256-gcm",
    "envelope-encryption",
    "key-rotation",
    "aad",
    "byok",
    "secrets",
    "web-crypto",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/seal"
  },
  "publishConfig": {
    "access": "public"
  }
}
