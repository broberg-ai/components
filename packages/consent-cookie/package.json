{
  "name": "@broberg/consent-cookie",
  "version": "0.3.0",
  "description": "GDPR cookie consent for any site: <broberg-consent>, a drop-in custom element (banner, settings panel, reopen handle) that works the same in Next, Vite+Preact and plain HTML and takes the site's @broberg/theme tokens, on top of a framework-free consent core (categories, policy-version re-surfacing, injectable storage, withdraw()).",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "happy-dom": "^15.0.0"
  },
  "keywords": [
    "gdpr",
    "consent",
    "cookie-banner",
    "cookie-consent",
    "privacy",
    "eprivacy",
    "consent-manager",
    "headless",
    "broberg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broberg-ai/components.git",
    "directory": "packages/consent-cookie"
  },
  "publishConfig": {
    "access": "public"
  }
}
