{
  "name": "@broberg/provider-usage",
  "version": "0.1.0",
  "description": "What each database, machine and bucket actually costs at the provider \u2014 one shape for UpCloud (billed per resource, today), with Scaleway, Cloudflare R2, Supabase and Fly to follow. Every line says whether it is billed or estimated; a key without billing rights answers no_billing_access, never an empty list. Cost price only; margins belong to the consumer.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report/results.json && node ../../scripts/mutations-if-changed.mjs test/mutations.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "billing",
    "usage",
    "cost",
    "upcloud",
    "scaleway",
    "cloudflare",
    "finops",
    "invoice"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/broberg-ai/components",
    "directory": "packages/provider-usage"
  },
  "publishConfig": {
    "access": "public"
  }
}
